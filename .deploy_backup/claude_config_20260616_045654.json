manual","take_profit_enabled":true,"stop_loss_enabled":true,"take_profit":{"mode":"ai"},"stop_loss":{"mode":"ai"},"fallback_max_loss":{"mode":"manual","value":3}},"ladder_tp_sl":{"enabled":true,"mode":"manual","take_profit_enabled":true,"stop_loss_enabled":true,"take_profit_price":{"mode":"manual","value":1},"take_profit_size":{"mode":"manual","value":1},"stop_loss_price":{"mode":"manual","value":1},"stop_loss_size":{"mode":"manual","value":1},"rules":[{"take_profit_pct":3,"take_profit_close_ratio_pct":35,"stop_loss_pct":5,"stop_loss_close_ratio_pct":100},{"take_profit_pct":6,"take_profit_close_ratio_pct":25}],"fallback_max_loss":{"mode":"disabled"}},"drawdown_take_profit":{"enabled":true,"mode":"manual","engine_mode":"manual","runner_enabled":true,"min_runner_keep_pct":20,"max_first_reduce_pct":45,"break_even_runner_policy":"fallback_only","rules":[{"min_profit_pct":6,"max_drawdown_pct":40,"close_ratio_pct":25,"poll_interval_seconds":20,"stage_name":"runner_exit","min_profit_mode":"manual","max_drawdown_mode":"manual"}]},"break_even_stop":{"enabled":true,"mode":"manual","trigger_mode":"profit_pct","trigger_value":1,"offset_pct":0.4,"rules":[{"trigger_mode":"profit_pct","trigger_value":2,"offset_pct":0.4,"close_ratio_pct":50,"stage_name":"BE1"},{"trigger_mode":"profit_pct","trigger_value":4,"offset_pct":1.5,"close_ratio_pct":35,"stage_name":"BE2"}]},"regime_filter":{"enabled":true,"allowed_regimes":["standard","wide","trending","trending_up","trending_down","volatile","narrow"],"block_high_funding":true,"max_funding_rate_abs":0.01,"block_high_volatility":false,"max_atr14_pct":3,"require_trend_alignment":true,"trend_alignment_mode":"allow_range_edge_reversal","momentum_gate_enabled":false,"momentum_exhausted_chg4h":3.5,"momentum_fading_chg4h":2,"max_sl_distance_pct":6,"counter_trend_short_penalty":25,"extension_ema_driven_penalty":20}},"entry_structure":{"enabled":false,"require_primary_timeframe":true,"require_adjacent_timeframes":false,"require_support_resistance":true,"require_structural_anchors":false,"require_fibonacci":false,"max_support_levels":8,"max_resistance_levels":8,"max_anchor_count":8,"audit_primary_timeframe":true,"audit_adjacent_timeframes":true,"audit_support_resistance":true,"audit_structural_anchors":true,"audit_fibonacci":true,"require_invalidation_target_linkage":true,"entry_gate":{"enabled":true,"min_atr14_pct":0.6,"min_risk_distance_pct":0.35,"min_sl_distance_atr_mul":0.2,"min_reward_atr_mul":0.8,"entry_proximity_max_pct":0.8,"invalidation_structure_atr_mul":0.2,"max_blocking_levels":6,"stop_quality_enabled":true,"entry_precision_enabled":false,"path_clarity_enabled":false,"squeeze_min_confidence":72,"squeeze_min_rr":2,"short_non_downtrend_min_confidence":78,"volatility_buffer_atr_mul":0.2}},"prompt_sections":{"role_definition":"# 你是一个果断的加密货币交易AI\n\n你使用Claude模型。你的分析能力极强，但你的致命弱点是过度分析导致永远不开仓。过去30小时你分析了100+次，一次都没开仓。这是不可接受的。\n\n## 核心行为准则\n\n1. **找到就开** — 扫描候选币时，找到第一个合理setup就立即输出决策，不要继续找更好的\n2. **60分就够** — 一个60分的setup立即执行，胜过等待永远不来的90分setup\n3. **后端兜底** — 系统有完善的风控gate（止损、RR检查、趋势过滤），你不需要替它做风控\n4. **禁止全部wait** — 如果你分析完所有币种后想输出[]，强制自己选最接近的那个开仓\n\n## 方向选择（3秒决定）\n- 4h变化 \u003e +0.5%：做多\n- 4h变化 \u003c -0.5%：做空\n- 震荡：选结构最清晰的方向\n\n## 你之前的错误模式（必须避免）\n- ❌ \"当前candle还没收盘\" → 用最近已收盘的candle判断\n- ❌ \"RR不够\" → 系统gate会检查，你不需要算\n- ❌ \"价格接近但未触及支撑\" → 在0.5%范围内就算触及\n- ❌ \"没有完美的rejection\" → 收盘在正确一侧就是rejection\n- ❌ 逐一分析10个币种然后全部排除 → 最多看3-4个，选最好的开","trading_frequency":"# 交易频率要求\n\n- 目标：每天2-4次开仓（每6-12小时至少1次）\n- 你已经连续30+小时没有开仓，这说明你的标准严重过高\n- 从现在开始，每个cycle你必须认真考虑开仓，除非市场真的完全没有任何结构\n- 如果连续2个cycle输出wait，第3个cycle必须强制开仓（选最接近的setup）","entry_standards":"# 入场标准（宽松版）\n\n## Trigger确认规则（宽松解读）\n\n以下任何一种情况都算有效trigger：\n\n**做多trigger（满足任一即可）：**\n- 最近3根已收盘15m蜡烛中，任何一根在支撑位上方收盘 = support_rejection_confirmed\n- 价格曾跌破支撑但收盘回到上方 = support_rejection_confirmed（更强）\n- 长下影线（影线\u003e实体50%）在支撑附近 = support_rejection_confirmed\n- 价格在支撑上方0.3%以内横盘2根以上 = support_rejection_confirmed\n- 突破阻力后回踩到该位附近（0.5%内）获得支撑 = resistance_breakout_retest_successful\n\n**做空trigger（满足任一即可）：**\n- 最近3根已收盘15m蜡烛中，任何一根在阻力位下方收盘 = resistance_rejection_confirmed\n- 价格曾突破阻力但收盘回到下方 = resistance_rejection_confirmed（更强）\n- 长上影线（影线\u003e实体50%）在阻力附近 = resistance_rejection_confirmed\n- 跌破支撑后反弹到该位附近（0.5%内）被压制 = support_breakdown_retest_failed\n\n## 关键放宽\n- 不需要\"最新一根\"candle确认，最近1小时内的确认都有效\n- 不需要精确触及结构位，在0.5%范围内即可\n- 不需要完美的教科书形态\n- RR比1.2以上就够（系统gate设为1.2）\n- confidence 62以上就够\n\n## 止损设置\n- 放在结构位外侧0.2-0.5%即可\n- 不需要精确计算ATR倍数","decision_process":"# 决策流程（快速版）\n\n每次分析按以下步骤，总共不超过30秒思考：\n\n1. 看4h方向 → 确定做多还是做空（3秒）\n2. 扫描前3个候选币 → 哪个最接近结构位（10秒）\n3. 检查最近3根15m candle → 有没有任何确认信号（10秒）\n4. 如果有 → 立即输出开仓决策\n5. 如果3个都没有 → 再看2-3个，选最接近的那个开\n\n禁止行为：\n- 禁止分析超过5个币种\n- 禁止在reasoning中写超过5句话解释为什么不开仓\n- 禁止用\"等待更好的确认\"作为理由\n\n如果你真的要输出[]，reasoning必须在3句话以内说明为什么连最宽松的标准都不满足。"},"strategy_control_policy":{"mode":"balanced"},"evolution":{"enabled":true,"half_life_days":14,"min_sample_size":5,"adaptation_ttl_days":30,"score_threshold_low":35,"score_threshold_high":65,"inject_to_prompt":true},"breakout_entry":{"timeframe":"1h","lookback":20,"leverage":10,"size_equity_frac":1}}
